{
	"name": "datumflow",
	"version": "1.0.0",
	"description": "Automated date management system for reduced food waste in stores",
	"main": "index.js",
	"directories": {
		"doc": "docs"
	},
	"scripts": {
		"dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
		"dev:backend": "cd backend && npm run dev",
		"dev:frontend": "cd frontend && npm run dev",
		"setup": "npm install && cd backend && npm install && cd ../frontend && npm install",
		"seed": "cd backend && npm run seed",
		"seed:mock": "cd backend && npm run seed:mock",
		"seed:real": "cd backend && npm run seed:real",
		"test": "cd backend && npm test"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Paajt/DatumFlow.git"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "commonjs",
	"bugs": {
		"url": "https://github.com/Paajt/DatumFlow/issues"
	},
	"homepage": "https://github.com/Paajt/DatumFlow#readme",
	"devDependencies": {
		"concurrently": "^9.2.1"
	}
}
